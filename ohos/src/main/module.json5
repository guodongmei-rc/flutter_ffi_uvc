{
  "module": {
    "name": "flutter_ffi_uvc",
    "type": "har",
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.SHORT_TERM_WRITE_IMAGEVIDEO",
        "reason": "$string:short_term_write_reason",
        "usedScene": {
          "when": "inuse"
        }
      }
    ]
  }
}
